# Copy this file to .env and fill in your keys. Never share or commit .env.

# Claude (console.anthropic.com -> API Keys)
ANTHROPIC_API_KEY=

# ElevenLabs: one or more keys, comma-separated; the next one is used when an account runs out of credits
ELEVENLABS_API_KEYS=

# Google Images through Serper.dev
SERPER_API_KEY=

# Telegram: token from @BotFather; owner id = your own Telegram user id (send /start to the bot to see it)
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=

# Instagram (see SETUP.md)
IG_USER_ID=
IG_ACCESS_TOKEN=
# IG_GRAPH_HOST=graph.instagram.com      # use graph.facebook.com if your token comes from Facebook Login
# IG_API_VERSION=v23.0

# Schedule
TIMEZONE=Africa/Casablanca
DAILY_TIME=09:00
TOPICS_PER_DAY=4

# Optional
# CLAUDE_MODEL=claude-opus-5-5
# BRAND=MEDLOUT AUTO
# BRAND_AR=ميدلوت أوتو
# MUSIC_FILE=assets/music/background.mp3
